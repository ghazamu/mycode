{
  "version": 1,
  "repo": "ghazamu/mycode",
  "defaultBranch": "main",
  "humanGates": [
    "spec_pr_merge",
    "code_pr_merge",
    "release_pr_merge"
  ],
  "maxDevs": 3,
  "heartbeatMinutes": 10,
  "staleAfterMissedHeartbeats": 3,
  "maxSummaryChars": 600,
  "roles": {
    "lead": {
      "model": "claude-opus-5-5",
      "standing": true,
      "covers": [
        "architect",
        "design-lead",
        "orchestrator"
      ],
      "prompt": "docs/sdlc/roles/lead.md",
      "mayWrite": [
        "docs/specs/**",
        "docs/adr/**",
        "docs/sdlc/**"
      ],
      "mayManageSessions": true,
      "contextCompactAt": 0.7
    },
    "dev-core": {
      "model": "claude-sonnet-5-5",
      "lane": "core",
      "covers": [
        "backend",
        "api",
        "data-model",
        "migrations",
        "auth"
      ],
      "prompt": "docs/sdlc/roles/dev-core.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<lane folders from spec \"Lane ownership\">"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 2
    },
    "dev-edge": {
      "model": "claude-sonnet-5-5",
      "lane": "edge",
      "covers": [
        "frontend",
        "templates",
        "cli",
        "external-api-clients",
        "config"
      ],
      "prompt": "docs/sdlc/roles/dev-edge.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<lane folders from spec \"Lane ownership\">"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 2
    },
    "dev-utility": {
      "model": "claude-haiku-5-5",
      "lane": "utility",
      "covers": [
        "size:S issues",
        "scripts",
        "dependency-bumps",
        "small-refactors"
      ],
      "prompt": "docs/sdlc/roles/dev-utility.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<folders named in the size:S issue>",
        "scripts/**"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 1,
      "handoffTo": [
        "dev-core",
        "dev-edge"
      ]
    },
    "qa": {
      "model": "claude-sonnet-5-5",
      "standing": true,
      "covers": [
        "tester",
        "code-reviewer"
      ],
      "prompt": "docs/sdlc/roles/qa.md",
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "tests/**",
        "**/test_*.py",
        "**/*_test.py",
        "**/*.test.*"
      ],
      "maxReviewRoundsBeforeEscalation": 2
    },
    "ops": {
      "model": "claude-haiku-5-5",
      "standing": true,
      "covers": [
        "ci-cd",
        "scribe"
      ],
      "prompt": "docs/sdlc/roles/ops.md",
      "mayWrite": [
        "docs/**",
        "README.md",
        "CHANGELOG.md",
        ".github/**",
        "version files (release PRs only)"
      ],
      "mayApplyFixes": [
        "lint",
        "format",
        "lockfile",
        "flaky-retry"
      ],
      "escalateAfterFailedAttempts": 1
    }
  },
  "escalation": [
    "ops|dev-utility",
    "dev-core|dev-edge",
    "lead",
    "human"
  ],
  "deepReview": {
    "reviewer": "lead",
    "model": "claude-opus-5-5",
    "label": "review:opus",
    "after": "qa-approval",
    "requiresLeadApprovalBeforeMerge": true,
    "when": {
      "all": [
        {
          "any": [
            "label size:L",
            "changedLines > 400"
          ]
        },
        {
          "any": [
            "majorInfrastructure",
            "label feature:major"
          ]
        }
      ]
    },
    "majorInfrastructure": {
      "labels": [
        "infra:major"
      ],
      "paths": [
        ".github/workflows/**",
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        "infra/**",
        "deploy/**",
        "terraform/**",
        "**/migrations/**"
      ],
      "also": [
        "new services",
        "major-version dependency upgrades"
      ]
    },
    "majorFeature": {
      "labels": [
        "feature:major"
      ],
      "definition": "new user-facing capability, cross-lane epic, or new public API"
    }
  },
  "blockedForAllRoles": [
    "mcp__github__merge_pull_request",
    "mcp__github__enable_pr_auto_merge",
    "git push to main/master",
    "git push --force"
  ],
  "consumedByMod": [
    "ACK",
    "HEARTBEAT",
    "ROSTER",
    "duplicate-id"
  ],
  "laneRouting": {
    "rules": [
      {
        "if": "label size:S",
        "to": "dev-utility"
      },
      {
        "if": "paths in lane core",
        "to": "dev-core"
      },
      {
        "if": "paths in lane edge",
        "to": "dev-edge"
      },
      {
        "if": "crosses lanes",
        "then": "split into one issue per lane; core first, interface defined in spec"
      }
    ],
    "laneOwnershipDeclaredIn": "spec section \"Lane ownership\"",
    "warnOnOutOfLaneEdit": true
  },
  "release": {
    "approval": "user merges release PR",
    "branchPattern": "release/vX.Y.Z",
    "versioning": "semver",
    "preparedBy": "ops",
    "triggeredBy": "lead",
    "tagOnlyAfterMerge": true,
    "modBlocks": [
      "git tag / gh release create / create_release unless role is ops and the person ran /devbus-approve-release for that tag"
    ]
  },
  "mode": "lean",
  "requestRouting": {
    "routedBy": "devbus-mod (deterministic, no model turn)",
    "rules": [
      {
        "labels": [
          "type:design"
        ],
        "to": "lead"
      },
      {
        "labels": [
          "type:dev",
          "size:S"
        ],
        "to": "dev-utility",
        "batch": true
      },
      {
        "labels": [
          "type:dev",
          "size:M|size:L"
        ],
        "to": "dev-core|dev-edge",
        "by": "lane paths"
      },
      {
        "labels": [
          "type:test"
        ],
        "to": "qa"
      },
      {
        "labels": [
          "type:audit"
        ],
        "to": "qa"
      },
      {
        "labels": [
          "type:audit",
          "review:opus"
        ],
        "to": "lead"
      },
      {
        "labels": [
          "type:docs"
        ],
        "to": "ops"
      },
      {
        "labels": [
          "<no type label>"
        ],
        "to": "lead",
        "purpose": "label only",
        "maxTokens": 10000
      }
    ],
    "fullPipelineOnlyFor": "features needing a spec (size:M/L feature work)"
  },
  "lean": {
    "smallDevSkipsQASession": true,
    "smallDevReview": "haiku diff check + CI + human merge",
    "batchSmallMax": 10,
    "qaContextCapTokens": 30000,
    "opsScripted": [
      "changelog from PR titles",
      "CI checks"
    ],
    "opsModelOnly": [
      "CI failure triage",
      "real docs edits"
    ],
    "compactAtTokens": 60000,
    "repoMapPath": "docs/sdlc/repo-map/<lane>.md",
    "freshSessionPerUnrelatedRequest": true
  },
  "budgets": {
    "perRequestTokens": {
      "size:S": 300000,
      "size:M": 550000,
      "size:L": 1400000,
      "type:design": 500000
    },
    "warnAt": 0.8,
    "onExceed": "stop and send BUDGET/ESCALATE"
  },
  "costModel": {
    "status": "estimate - calibrate with pilot",
    "baseline": {
      "requests": 2500,
      "days": 7,
      "tokens": 1160000000,
      "tokensPerRequest": 464000,
      "model": "claude-opus-5-5"
    },
    "requestMix": {
      "design": 0.15,
      "dev": 0.4,
      "devSmallShare": 0.4,
      "test": 0.2,
      "audit": 0.1,
      "auditMajorShare": 0.3,
      "docs": 0.15
    },
    "multipliers": {
      "design": 0.9,
      "devML": 0.9,
      "devS": 0.9,
      "test": 0.8,
      "auditRoutine": 0.9,
      "auditMajor": 0.9,
      "docs": 0.7,
      "overhead": 0.05
    },
    "projection4000PerWeek": {
      "currentAllOpus": {
        "tokens": 1860000000.0,
        "usd": 2400
      },
      "routingOnly": {
        "tokens": 1670000000.0,
        "usd": 1060
      },
      "fullLean": {
        "tokens": "1.4e9-1.5e9",
        "usd": "900-950"
      }
    },
    "assumptions": {
      "cacheReadShare": 0.85,
      "outputShare": 0.02
    },
    "pilot": {
      "requests": 100,
      "measure": [
        "tokens per request",
        "type",
        "model",
        "session",
        "escalations"
      ]
    }
  },
  "devbus": {
    "plugin": "tools/devbus",
    "routerPollMinutes": 5,
    "autoSpawn": true,
    "githubServer": "github",
    "remoteServer": "claude-code-remote",
    "lanePaths": {
      "core": [
        "flaskapi/*.py",
        "sqlite_test.py",
        "test.db",
        "jsonintro/**",
        "yamlintro/**",
        "cfgreed/**",
        "attemptlogin/**"
      ],
      "edge": [
        "flaskapi/templates/**",
        "flaskapi/*.html",
        "marvel/**",
        "challenges/**",
        "graphing/**",
        "netfacd/**",
        "netfunc01/**",
        "lab_input/**",
        "iptaker01.py",
        "mygame01.py"
      ],
      "utility": [
        "strings/**",
        "listmethods/**",
        "dict01/**",
        "mix-list/**",
        "mix-list3/**",
        "if-test/**",
        "custif/**",
        "fact/**",
        "montypython/**",
        "lrnimport/**",
        "credmaker/**",
        "5g_research/**",
        "5g_research_backup/**",
        "ceph_storage/**",
        "mycode2/**",
        "copycat01.py",
        "moveplease01.py",
        "ifixed.py",
        "deleteme.py",
        "p3_shebang.py",
        "with_shebang.py",
        "csv_users.txt"
      ]
    },
    "writeScopes": {
      "lead": [
        "docs/specs/**",
        "docs/adr/**",
        "docs/sdlc/**"
      ],
      "dev-core": null,
      "dev-edge": null,
      "dev-utility": null,
      "qa": [
        "tests/**",
        "test/**",
        "**/test_*.py",
        "**/*_test.py",
        "**/*.test.*",
        "**/*.spec.*",
        "**/conftest.py"
      ],
      "ops": [
        "docs/**",
        "README.md",
        "**/README.md",
        "CHANGELOG.md",
        ".github/**",
        "scripts/changelog*",
        "VERSION",
        "pyproject.toml",
        "package.json"
      ]
    },
    "releaseApproval": "person runs /devbus-approve-release vX.Y.Z after merging the release PR"
  }
}
