{
  "version": 1,
  "repo": "ghazamu/mycode",
  "defaultBranch": "main",
  "humanGates": [
    "spec_pr_merge",
    "code_pr_merge",
    "release_pr_merge"
  ],
  "maxDevs": 3,
  "heartbeatMinutes": 10,
  "staleAfterMissedHeartbeats": 3,
  "maxSummaryChars": 600,
  "roles": {
    "lead": {
      "model": "claude-opus-5-5",
      "standing": true,
      "covers": [
        "architect",
        "design-lead",
        "orchestrator"
      ],
      "prompt": "docs/sdlc/roles/lead.md",
      "mayWrite": [
        "docs/specs/**",
        "docs/adr/**",
        "docs/sdlc/**"
      ],
      "mayManageSessions": true,
      "contextCompactAt": 0.7
    },
    "dev-core": {
      "model": "claude-sonnet-5-5",
      "lane": "core",
      "covers": [
        "backend",
        "api",
        "data-model",
        "migrations",
        "auth"
      ],
      "prompt": "docs/sdlc/roles/dev-core.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<lane folders from spec \"Lane ownership\">"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 2
    },
    "dev-edge": {
      "model": "claude-sonnet-5-5",
      "lane": "edge",
      "covers": [
        "frontend",
        "templates",
        "cli",
        "external-api-clients",
        "config"
      ],
      "prompt": "docs/sdlc/roles/dev-edge.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<lane folders from spec \"Lane ownership\">"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 2
    },
    "dev-utility": {
      "model": "claude-haiku-5-5",
      "lane": "utility",
      "covers": [
        "size:S issues",
        "scripts",
        "dependency-bumps",
        "small-refactors"
      ],
      "prompt": "docs/sdlc/roles/dev-utility.md",
      "standing": false,
      "elastic": true,
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "<folders named in the size:S issue>",
        "scripts/**"
      ],
      "branchPattern": "feat/<n>-<slug>|fix/<n>-<slug>",
      "escalateAfterFailedAttempts": 1,
      "handoffTo": [
        "dev-core",
        "dev-edge"
      ]
    },
    "qa": {
      "model": "claude-sonnet-5-5",
      "standing": true,
      "covers": [
        "tester",
        "code-reviewer"
      ],
      "prompt": "docs/sdlc/roles/qa.md",
      "subagentModel": "claude-haiku-5-5",
      "mayWrite": [
        "tests/**",
        "**/test_*.py",
        "**/*_test.py",
        "**/*.test.*"
      ],
      "maxReviewRoundsBeforeEscalation": 2
    },
    "ops": {
      "model": "claude-haiku-5-5",
      "standing": true,
      "covers": [
        "ci-cd",
        "scribe"
      ],
      "prompt": "docs/sdlc/roles/ops.md",
      "mayWrite": [
        "docs/**",
        "README.md",
        "CHANGELOG.md",
        ".github/**",
        "version files (release PRs only)"
      ],
      "mayApplyFixes": [
        "lint",
        "format",
        "lockfile",
        "flaky-retry"
      ],
      "escalateAfterFailedAttempts": 1
    }
  },
  "escalation": [
    "ops|dev-utility",
    "dev-core|dev-edge",
    "lead",
    "human"
  ],
  "deepReview": {
    "reviewer": "lead",
    "model": "claude-opus-5-5",
    "label": "review:opus",
    "after": "qa-approval",
    "requiresLeadApprovalBeforeMerge": true,
    "when": {
      "all": [
        {
          "any": [
            "label size:L",
            "changedLines > 400"
          ]
        },
        {
          "any": [
            "majorInfrastructure",
            "label feature:major"
          ]
        }
      ]
    },
    "majorInfrastructure": {
      "labels": [
        "infra:major"
      ],
      "paths": [
        ".github/workflows/**",
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        "infra/**",
        "deploy/**",
        "terraform/**",
        "**/migrations/**"
      ],
      "also": [
        "new services",
        "major-version dependency upgrades"
      ]
    },
    "majorFeature": {
      "labels": [
        "feature:major"
      ],
      "definition": "new user-facing capability, cross-lane epic, or new public API"
    }
  },
  "blockedForAllRoles": [
    "mcp__github__merge_pull_request",
    "mcp__github__enable_pr_auto_merge",
    "git push to main/master",
    "git push --force"
  ],
  "consumedByMod": [
    "ACK",
    "HEARTBEAT",
    "ROSTER",
    "duplicate-id"
  ],
  "laneRouting": {
    "rules": [
      {
        "if": "label size:S",
        "to": "dev-utility"
      },
      {
        "if": "paths in lane core",
        "to": "dev-core"
      },
      {
        "if": "paths in lane edge",
        "to": "dev-edge"
      },
      {
        "if": "crosses lanes",
        "then": "split into one issue per lane; core first, interface defined in spec"
      }
    ],
    "laneOwnershipDeclaredIn": "spec section \"Lane ownership\"",
    "warnOnOutOfLaneEdit": true
  },
  "release": {
    "approval": "user merges release PR",
    "branchPattern": "release/vX.Y.Z",
    "versioning": "semver",
    "preparedBy": "ops",
    "triggeredBy": "lead",
    "tagOnlyAfterMerge": true,
    "modBlocks": [
      "git tag / create release on a commit that is not the merge commit of a merged release/* PR"
    ]
  }
}
